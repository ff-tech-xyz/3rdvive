{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["${mod_author}"],
  "contact": {"sources": "https://github.com/ff-tech-xyz/3rdvive"},
  "license": "${license}",
  "environment": "client",
  "entrypoints": {"client": ["com.thirdvive.fabric.ThirdViveFabric"]},
  "mixins": ["thirdvive.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "vivecraft": [">=26.2-1.3.15", "<26.2-1.4.0"]
  }
}
